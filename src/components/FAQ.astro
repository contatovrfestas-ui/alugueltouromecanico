---
import type { IFaqItem } from '../lib/schema';

interface Props {
  items: IFaqItem[];
  titulo?: string;
}
const { items, titulo = 'Perguntas frequentes' } = Astro.props;
---

{items.length > 0 && (
  <section class="my-10">
    <h2>{titulo}</h2>
    <div class="space-y-3">
      {items.map((faq, i) => (
        <details class="bg-white border border-rodeio-creme-dark rounded-md p-4 group">
          <summary class="font-title text-rodeio-couro cursor-pointer list-none flex justify-between items-center">
            <span>{i + 1}. {faq.pergunta}</span>
            <span class="text-rodeio-terra group-open:rotate-180 transition-transform" aria-hidden>▼</span>
          </summary>
          <div class="mt-3 text-sm leading-relaxed text-rodeio-preto" set:html={faq.resposta} />
        </details>
      ))}
    </div>
  </section>
)}
